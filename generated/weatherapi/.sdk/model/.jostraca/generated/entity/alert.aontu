# Entity: alert

main: kit: entity: alert: {

  alias: field: {}

  fields: {
    alerts: {
      h: "Alerts"
      n: "alerts"
      r: false
      t: "`$OBJECT`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      sh: "Location metadata returned with every weather response."
      t: "`$OBJECT`"
    }
  }

  name: "alert"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /alerts.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "YOUR_API_KEY"
                k: "query"
                n: "key"
                or: "key"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "London"
                k: "query"
                n: "q"
                or: "q"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/alerts.json"
          q: {
            exist: [
              "key"
              "q"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "alerts.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
