              }
            ]
          }
          m: "GET"
          o: "/history.json"
          q: {
            exist: [
              "dt"
              "key"
              "q"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "history.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
