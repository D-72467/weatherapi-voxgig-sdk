                n: "q"
                or: "q"
                r: true
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "solar"
                or: "solar"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "tp"
                or: "tp"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 1490227200
                k: "query"
