                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "et0"
                or: "et0"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "hour"
                or: "hour"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "YOUR_API_KEY"
                k: "query"
                n: "key"
                or: "key"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "fr"
                k: "query"
                n: "lang"
                or: "lang"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "no"
