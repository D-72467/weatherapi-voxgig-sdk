# Entity: timezone

main: kit: entity: timezone: {

  alias: field: {}

  fields: {
    country: {
      h: "Country"
      n: "country"
      r: false
      sh: "Country name"
      t: "`$STRING`"
    }
    lat: {
      fo: "float"
      h: "Lat"
      n: "lat"
      r: false
      sh: "Latitude"
      t: "`$NUMBER`"
    }
    localtime: {
      h: "Localtime"
      n: "localtime"
      r: false
      sh: "Local date and time string"
      t: "`$STRING`"
    }
    localtime_epoch: {
      h: "Localtime Epoch"
      n: "localtime_epoch"
      r: false
      sh: "Local time as Unix epoch"
      t: "`$INTEGER`"
    }
    lon: {
      fo: "float"
      h: "Lon"
      n: "lon"
      r: false
      sh: "Longitude"
      t: "`$NUMBER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Location name"
      t: "`$STRING`"
    }
    region: {
      h: "Region"
      n: "region"
      r: false
      sh: "Region or state"
      t: "`$STRING`"
    }
    tz_id: {
      h: "Tz Id"
      n: "tz_id"
      r: false
      sh: "IANA timezone ID, e.g."
      t: "`$STRING`"
    }
  }

  name: "timezone"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /timezone.json"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "YOUR_API_KEY"
                k: "query"
                n: "key"
                or: "key"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "London"
                k: "query"
                n: "q"
                or: "q"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/timezone.json"
          q: {
            exist: [
              "key"
              "q"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "timezone.json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.location`"
          }
        }
      ]
    }
  }



}
